local function rn(n)
    local c = "Il1O0abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ"
    local s = ""
    for i = 1, (n or 10) do
        local i2 = math.random(1, #c)
        s = s .. c:sub(i2, i2)
    end
    return s
end

