local function fireP(p)
    if not p or not p.Parent then return end
    pcall(function()
        if fireproximityprompt then
            fireproximityprompt(p)
        else
            p:InputHoldBegin()
            task.wait((p.HoldDuration and p.HoldDuration > 0) and p.HoldDuration or 0.05)
            p:InputHoldEnd()
        end
    end)
end

local function fireC(d)
    if not d or not d.Parent then return end
    pcall(function()
        if fireclickdetector then fireclickdetector(d) end
    end)
end

-- lightweight prompt cache (refresh every few seconds)
local cache = { prompts = {}, clicks = {}, t = 0 }
local function refreshCache()
    local now = os.clock()
    if now - cache.t < 2.5 then return end
    cache.t = now
    local pr, cl = {}, {}
    for _, o in ipairs(S.WS:GetDescendants()) do
        if o:IsA("ProximityPrompt") then
            table.insert(pr, o)
        elseif o:IsA("ClickDetector") then
            table.insert(cl, o)
        end
    end
    cache.prompts = pr
    cache.clicks = cl
end

local function matchText(s, list)
    s = string.lower(s or "")
    for i = 1, #list do
        if string.find(s, list[i], 1, true) then return true end
    end
    return false
end

